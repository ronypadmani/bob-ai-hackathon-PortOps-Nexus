# Port Operations Copilot — Environment Configuration
# Copy this file to .env and adjust variables as needed.

# Application Settings
APP_NAME="Port Operations Copilot"
APP_ENV="development"
PORT_NAME="Port of Metroplex / San Pedro Bay Complex"
PLANNING_HORIZON_HOURS=72

# IBM Watsonx & AI Configuration (Optional, fallback provided if unset)
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Optimization Settings
ORTOOLS_SOLVER_TIME_LIMIT_SECONDS=30
ENABLE_REROUTING_RECOMMENDATIONS=true

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
